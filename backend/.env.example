# =============================================================================
# FreightFlow / FedExUS - production environment template
# =============================================================================
# Copy this file to backend/.env on the server and fill in real values.
# NEVER commit the real backend/.env file to GitHub.
#
# IMPORTANT:
# - Do NOT generate a new APP_KEY for an existing installation. Copy the
#   production APP_KEY that was used by the live database. Changing it will
#   make existing encrypted values (payment gateway credentials, tokens, etc.)
#   unreadable.
# - Website title, logo, bank accounts, enabled payment gateways and other
#   editable content are stored in the database through the Admin Settings
#   screens. Do not move those settings into this file.
# =============================================================================

APP_NAME=FreightFlow
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Logging (keep logs outside the public document root)
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# -----------------------------------------------------------------------------
# Database - MySQL / MariaDB on OgaHosting
# Create the database and database user in the hosting control panel first.
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Only set this when the host requires a custom CA certificate.
# MYSQL_ATTR_SSL_CA=/home/your_account/private/ca.pem

# -----------------------------------------------------------------------------
# Sessions, cache and queues
# Shared hosting safe defaults: file sessions, file cache, synchronous queue.
# Do not switch to database sessions unless the sessions table exists.
# -----------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_EXPIRE_ON_CLOSE=false

CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

# Reverb/WebSockets are not assumed to be available on shared hosting.
# Leave these blank unless OgaHosting explicitly supports a persistent
# WebSocket process. The existing live chat must keep working through its
# AJAX polling implementation.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=https

# -----------------------------------------------------------------------------
# Filesystem
# Shipment photos are stored on the "public" disk and served through
# public/storage. Keep that persistent directory across deployments.
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=local
FILESYSTEM_PUBLIC_URL=/storage

# -----------------------------------------------------------------------------
# Mail / SMTP
# Configure a mailbox created in the hosting control panel. Do not assume the
# server can send mail without SMTP credentials.
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mail.your-domain.example
MAIL_PORT=587
MAIL_USERNAME=no-reply@your-domain.example
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@your-domain.example
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Sanctum / API
# -----------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=your-domain.example,www.your-domain.example

# -----------------------------------------------------------------------------
# Payment gateways
# These environment values are read by the server-side gateway adapters.
# Keep the Admin dashboard enable/disable switches working; do not hardcode
# credentials in Blade, JavaScript or committed configuration files.
# Preserve the existing test/live separation. All callbacks/webhooks must be
# verified server-side before a payment is marked paid.
# -----------------------------------------------------------------------------
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=live

FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# -----------------------------------------------------------------------------
# Optional proxy configuration (only if the host terminates TLS upstream)
# -----------------------------------------------------------------------------
# TRUSTED_PROXIES=
